<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.redflag.fx.DeviceTabController" spacing="10" styleClass="chart-container">
    <LineChart fx:id="deltaChart" title="Packet Inter-Arrival Time Δt (milliseconds)"
               createSymbols="false" animated="false" prefHeight="230.0">
        <xAxis><NumberAxis fx:id="deltaXAxis" label="Sequence #" forceZeroInRange="false" autoRanging="false" animated="false"/></xAxis>
        <yAxis><NumberAxis label="Δt (ms)" forceZeroInRange="true" animated="false"/></yAxis>
    </LineChart>

    <LineChart fx:id="stdChart" title="Temporal Regularity Dispersion σ_20 (ms)"
               createSymbols="false" animated="false" prefHeight="230.0">
        <xAxis><NumberAxis fx:id="stdXAxis" label="Sequence #" forceZeroInRange="false" autoRanging="false" animated="false"/></xAxis>
        <yAxis><NumberAxis label="std (ms)" forceZeroInRange="true" animated="false"/></yAxis>
    </LineChart>

    <AreaChart fx:id="scoreChart" title="Mirai Botnet Attack Probability Score P(Attack)"
               createSymbols="false" animated="false" prefHeight="230.0">
        <xAxis><NumberAxis fx:id="scoreXAxis" label="Sequence #" forceZeroInRange="false" autoRanging="false" animated="false"/></xAxis>
        <yAxis><NumberAxis label="Probability" lowerBound="0.0" upperBound="1.0" autoRanging="false" animated="false"/></yAxis>
    </AreaChart>
    
    <HBox spacing="28" styleClass="bottom-bar">
      <Label fx:id="lblThroughput" text="0 pkt/s" styleClass="metric-label"/>
      <Label fx:id="lblLatency" text="infer: - µs" styleClass="metric-label"/>
      <Label fx:id="lblHttp" text="HTTP 200 [PASSED]" styleClass="metric-label"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="statusBadge" text="SAFE" styleClass="badge, badge-safe"/>
      <Label text="Threat Probability:" styleClass="sub-label"/>
      <ProgressBar fx:id="scoreGauge" progress="0.0" prefWidth="220.0" styleClass="threat-gauge"/>
      <Button text="Isolate Node" fx:id="btnIsolate" onAction="#handleIsolate" styleClass="action-btn" />
      <Button text="Dismiss Alert" fx:id="btnDismiss" onAction="#handleDismiss" visible="false" />
    </HBox>
</VBox>
