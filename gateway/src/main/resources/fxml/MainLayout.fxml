<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.redflag.fx.MainLayoutController" styleClass="root-pane"
            prefWidth="1280.0" prefHeight="800.0">
    <left>
        <VBox spacing="10" styleClass="sidebar">
            <padding><Insets top="20" right="10" bottom="20" left="10"/></padding>
            <Label text="REDFLAG" styleClass="sidebar-title"/>
            <Separator />
            <Button fx:id="btnDashboard" text="Dashboard" onAction="#showDashboard" styleClass="nav-button"/>
            <Button fx:id="btnDevices" text="Devices &amp; Telemetry" onAction="#showDevices" styleClass="nav-button"/>
            <Button fx:id="btnReports" text="Mitigation Reports" onAction="#showReports" styleClass="nav-button"/>
            <Button fx:id="btnUsers" text="User Management" onAction="#showUsers" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Logout" onAction="#handleLogout" styleClass="nav-button, nav-logout"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" />
    </center>
    <!-- Non-blocking Alert Banner -->
    <top>
        <StackPane fx:id="alertPane" visible="false" style="-fx-background-color: #CC0000; -fx-padding: 10;">
            <Label fx:id="alertLabel" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="ATTACK DETECTED"/>
        </StackPane>
    </top>
</BorderPane>
