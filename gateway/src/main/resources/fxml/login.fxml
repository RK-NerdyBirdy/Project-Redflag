<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.redflag.fx.LoginController"
            prefWidth="800.0" prefHeight="500.0" styleClass="login-root">
    <left>
        <VBox styleClass="login-left-panel" prefWidth="340.0" alignment="CENTER_LEFT" spacing="14">
            <padding>
                <Insets top="40" right="30" bottom="40" left="36"/>
            </padding>
            <Label text="REDFLAG" styleClass="login-logo"/>
            <Label text="IoT Volumetric Flood Detection" styleClass="login-tagline"/>
            <Label text="Edge Defense &amp; Real-time AI Mitigation" style="-fx-text-fill: #666666; -fx-font-size: 12px;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="4">
                <Label text="SECURITY GATEWAY TERMINAL" style="-fx-text-fill: #aa0000; -fx-font-weight: bold; -fx-font-size: 11px; -fx-letter-spacing: 1px;"/>
                <Label text="v1.0.0-PROD | SOC EDGE NODE" style="-fx-text-fill: #555555; -fx-font-size: 11px;"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane alignment="CENTER" style="-fx-padding: 30;">
            <VBox styleClass="login-form-card" maxWidth="380.0" spacing="16" alignment="CENTER_LEFT">
                <Label text="SECURE ACCESS GATE" style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                <Label text="Authenticate to monitor and control edge telemetry" style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>
                <Separator style="-fx-background-color: #330000; -fx-opacity: 0.5;"/>

                <VBox spacing="6">
                    <Label text="OPERATOR EMAIL" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <TextField fx:id="emailField" promptText="admin@example.com" styleClass="login-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="PASSWORD" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="login-field"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ProgressIndicator fx:id="loginProgress" visible="false" prefWidth="22" prefHeight="22"/>
                    <Label fx:id="errorLabel" styleClass="login-error" wrapText="true"/>
                </HBox>

                <Button fx:id="loginBtn" text="LOGIN" onAction="#handleLogin" maxWidth="Infinity" styleClass="login-btn"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
